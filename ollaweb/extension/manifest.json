{
  "manifest_version": 3,
  "name": "Voltaire Tailor",
  "version": "0.1.0",
  "description": "Send a job posting to Voltaire and auto-tailor your resume.",
  "action": {
    "default_title": "Tailor with Voltaire",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"]
}
